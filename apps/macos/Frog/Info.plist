<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Frog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_frog._tcp</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Cam Pedersen</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>frog on your iPhone connects to this Mac over your network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Frog listens only while you dictate into the composer. Speech is transcribed on this Mac; audio never leaves it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Frog turns your dictation into text on this Mac. Nothing is sent to Apple or anyone else.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>eco.frog.conversation</string>
	</array>
	<key>SUFeedURL</key>
	<string>https://frog.eco/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_KEY)</string>
</dict>
</plist>

#!/bin/sh
# frog-app: the frog window (Quickshell). One per user: a second launch
# brings the first forward instead.
#   frog-app [DIR]          open, new conversations work in DIR (default ~)
#   frog-app --ask TEXT     open and send TEXT as a new conversation
#   frog-app --resume ID    open and continue session ID
#   frog-app --new          open on a new conversation
#   frog-app --shot PATH    save the open window as a PNG
# FROG_APP_QML overrides where the QML lives.
set -eu
here=$(dirname "$(readlink -f "$0")")
qml=${FROG_APP_QML:-}
for d in "$here/quickshell" "$here/../share/frog/quickshell" /usr/share/frog/quickshell; do
  [ -n "$qml" ] && break
  [ -f "$d/shell.qml" ] && qml=$(cd "$d" && pwd)
done
[ -n "$qml" ] || { echo "frog-app: no QML found (set FROG_APP_QML)" >&2; exit 1; }

ipc() { qs -p "$qml" ipc call frog "$@" >/dev/null 2>&1; }
# start the window in the background and wait until it answers
launch() {
  qs -p "$qml" >/dev/null 2>&1 &
  i=0; until ipc raise; do i=$((i + 1)); [ $i -lt 50 ] || exit 1; sleep 0.1; done
}
case "${1:-}" in
  --ask)    shift; ipc ask "$*" || { launch; ipc ask "$*"; } ;;
  --resume) ipc resume "$2" || { export FROG_APP_RESUME=$2; launch; } ;;
  --new)    ipc newChat || launch ;;
  --shot)   qs -p "$qml" ipc call frog shot "$(readlink -f "$2")" ;;
  -h|--help) sed -n '2,10p' "$0" ;;
  *)        [ -d "${1:-}" ] && export FROG_APP_CWD="$(cd "$1" && pwd)"
            ipc raise || exec qs -p "$qml" ;;
esac

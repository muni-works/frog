{
  "name": "frog",
  "version": 2,
  "decided": "2026-11-11",
  "about": "The one design source for the Mac app (apps/FrogKit/UI/Basics/Tokens.swift) and the web app (apps/web/src/tokens.css). Edit this file, then run `node design/generate.mjs`. Spec: docs/design/frog-web/README.md, 'One look (Mac and web)'. A color with `css` becomes that CSS variable; one with `swift` becomes that `Tokens` member. Most tokens are both.",
  "color": [
    { "css": "canvas", "swift": "canvas", "light": "#ffffff", "dark": "#000000", "doc": "The page: the transcript and main area. True black in the dark, true white in the light." },
    { "css": "bg", "light": "#ffffff", "dark": "#000000", "doc": "The web's page ground, the same as canvas." },
    { "css": "sidebar", "swift": "sidebar", "light": "#fafafa", "dark": "#0a0a0a", "doc": "The sidebar and inspector: opaque, one step off the canvas." },
    { "css": "card", "swift": "raised", "light": "#f4f4f4", "dark": "#121212", "doc": "Cards, bubbles, the composer field, menus." },
    { "swift": "bubble", "light": "#f4f4f4", "dark": "#121212", "doc": "The prompt bubble: the same fill as cards." },
    { "css": "well", "swift": "well", "light": "#ececec", "dark": "#1a1a1a", "doc": "Wells inside a card: code, fields, the command in an ask card." },
    { "css": "hover", "swift": "hover", "light": "rgba(0, 0, 0, 0.05)", "dark": "rgba(255, 255, 255, 0.07)", "doc": "One quiet fill for a row under the pointer and the row you're on." },
    { "swift": "hairline", "light": "rgba(0, 0, 0, 0)", "dark": "rgba(255, 255, 255, 0)", "doc": "Dividers: clear (no lines); kept so call sites still compile while they move to fills." },
    { "swift": "hairlineStrong", "light": "rgba(0, 0, 0, 0.05)", "dark": "rgba(255, 255, 255, 0.06)", "doc": "Field strokes: a faint wash, for the few controls that still need an edge." },
    { "css": "line", "swift": "line", "light": "#e3e3e3", "dark": "#2a2a2a", "doc": "Rails that nest content (quotes, tool output, the sidebar's started-by tree). Never a border." },
    { "css": "line-strong", "light": "#d2d2d2", "dark": "#383838", "doc": "The rare control edge." },
    { "css": "fg", "light": "#1b1d1a", "dark": "#ececec", "doc": "Primary text on the web. Solid colour for consistent contrast." },
    { "css": "muted", "light": "#5e5e5e", "dark": "#a3a3a3", "doc": "Secondary text on the web (4.5:1 on the page). Solid colour for consistent contrast." },
    { "css": "faint", "light": "#767676", "dark": "#808080", "doc": "Placeholders, quiet mono arguments on the web. Solid colour for consistent contrast." },
    { "swift": "text", "light": "#1b1d1a", "dark": "#ececec", "doc": "Primary text on the Mac (solid, same as fg)." },
    { "swift": "textSecondary", "light": "#5e5e5e", "dark": "#a3a3a3", "doc": "Secondary text on the Mac (solid, same as muted)." },
    { "swift": "textTertiary", "light": "#767676", "dark": "#808080", "doc": "Tertiary text on the Mac (solid, same as faint)." },
    { "swift": "textQuaternary", "light": "#808080", "dark": "#808080", "doc": "Hints, the faintest meta (solid, same as faint)." },
    { "css": "frog", "swift": "accent", "light": "#2e9e4f", "dark": "#58cc6f", "doc": "THE accent: running, selected, verified, send. The only decorative color." },
    { "css": "on-frog", "light": "#ffffff", "dark": "#0d1a10", "doc": "Glyphs on a frog-green fill." },
    { "css": "frog-pad", "light": "rgba(46, 158, 79, 0.22)", "dark": "rgba(88, 204, 111, 0.22)", "doc": "The focus glow and spinner track." },
    { "swift": "signal", "light": "#cc851f", "dark": "#e5a54b", "doc": "Needs-you on the Mac (amber). Deprecated; use notice instead." },
    { "swift": "fail", "light": "#d9403b", "dark": "#ff6961", "doc": "Failed on the Mac. Deprecated; use warn instead." },
    { "css": "warn", "light": "#c4513d", "dark": "#e5775f", "doc": "Failed, removed, over a limit on the web (reddish-orange)." },
    { "css": "notice", "light": "#ff9500", "dark": "#ff9f0a", "doc": "Needs-you and nearing a limit on the web (orange)." },
    { "css": "notice-bg", "light": "rgba(255, 149, 0, 0.09)", "dark": "rgba(255, 159, 10, 0.09)", "doc": "A needs-you banner's fill." },
    { "css": "place-local", "swift": "placeLocal", "light": "#3478e0", "dark": "#64a4ff", "doc": "Where a model runs: local (this Mac or a paired node). Blue, the same lightness as the green beside it; 4.3:1 on white, 8.3:1 on black (the green is 3.4:1 and 10:1). Only through placeColor / Color.place(_:)." },
    { "css": "place-cloud", "swift": "placeCloud", "light": "#2e9e4f", "dark": "#58cc6f", "doc": "Where a model runs: any cloud (Frog Cloud, Anthropic, OpenAI). Frog green, the accent. Only through placeColor / Color.place(_:)." },
    { "css": "pr-failing", "swift": "prFailing", "light": "#d9403b", "dark": "#e5775f", "doc": "A PR's dot (pr.*): checks failing. Worst first: failing > checks > draft > approved > closed > merged. Only through prColor / Color.pr(_:)." },
    { "css": "pr-checks", "swift": "prChecks", "light": "#cc851f", "dark": "#ff9f0a", "doc": "A PR's dot: checks running." },
    { "css": "pr-draft", "swift": "prDraft", "light": "#8a8a8a", "dark": "#8e8e8e", "doc": "A PR's dot: a draft." },
    { "css": "pr-approved", "swift": "prApproved", "light": "#2e9e4f", "dark": "#58cc6f", "doc": "A PR's dot: approved and mergeable." },
    { "css": "pr-closed", "swift": "prClosed", "light": "#b04a3c", "dark": "#c9705f", "doc": "A PR's dot: closed without merging." },
    { "css": "pr-merged", "swift": "prMerged", "light": "#8250df", "dark": "#a887f0", "doc": "A PR's dot: merged." },
    { "css": "badge-bg", "light": "rgba(52, 199, 89, 0.18)", "dark": "rgba(48, 209, 88, 0.18)", "doc": "A green badge's fill." },
    { "css": "glass-fill", "light": "rgba(250, 250, 250, 0.9)", "dark": "rgba(10, 10, 10, 0.9)", "doc": "Floating menus and the palette: the sidebar fill, slightly see-through." },
    { "css": "glass-fallback", "light": "#fafafa", "dark": "#0a0a0a", "doc": "Glass where blur isn't available: the sidebar fill." },
    { "css": "glass-edge", "light": "rgba(255, 255, 255, 0.7)", "dark": "rgba(255, 255, 255, 0.12)", "doc": "The inset highlight on glass." },
    { "css": "mark-skin", "light": "#51da60", "dark": "#51da60", "doc": "The frog mark." },
    { "css": "mark-spot", "light": "#36b347", "dark": "#36b347", "doc": "The frog mark." },
    { "css": "mark-ink", "light": "#15171a", "dark": "#15171a", "doc": "The frog mark." },
    { "css": "mark-paper", "light": "#fbfbf9", "dark": "#fbfbf9", "doc": "The frog mark." },
    { "css": "icon-ground", "light": "#171a18", "dark": "#171a18", "doc": "The app icon's ground." },
    { "css": "icon-ground-deep", "light": "#0f110f", "dark": "#0f110f", "doc": "The app icon's ground, deep." }
  ],
  "shadow": [
    { "css": "shadow-cta", "light": "0 1px 0 rgba(255, 255, 255, 0.18) inset", "dark": "0 1px 0 rgba(255, 255, 255, 0.18) inset" },
    { "css": "shadow-float", "light": "0 16px 40px -14px rgba(0, 0, 0, 0.22)", "dark": "0 16px 40px -12px rgba(0, 0, 0, 0.95)" },
    { "css": "shadow-toast", "light": "0 8px 24px -10px rgba(0, 0, 0, 0.35)", "dark": "0 8px 24px -10px rgba(0, 0, 0, 0.35)" },
    { "css": "shadow-glass", "light": "0 1px 0 rgba(255, 255, 255, 0.7) inset, 0 8px 24px -14px rgba(0, 0, 0, 0.35)", "dark": "0 1px 0 rgba(255, 255, 255, 0.12) inset, 0 8px 24px -14px rgba(0, 0, 0, 0.35)" }
